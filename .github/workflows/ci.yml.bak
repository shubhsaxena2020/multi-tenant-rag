name: CI

on:
  push:
    branches: [master]
  pull_request:
    branches: [master]
  workflow_dispatch:

jobs:
  test:
    name: Test Suite
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      PYTHONPATH: "/home/ubuntu/rag-service:${PYTHONPATH}"
      PATH: "/home/ubuntu/rag-service/.venv/bin:$PATH"
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python and uv
        uses: oven-sh/setup-uv@v2
        with:
          version: "3.11"

      - name: Install dependencies
        run: |
          pip install pytest pytest-timeout ruff

      - name: Run fast unit-test subset
        run: |
          .venv/bin/pytest tests/ -m "unit" --durations=30 --cov=app --cov-report=term-missing -q
        timeout-minutes: 30

      - name: Run marked-subset (integration, exclude slow+external)
        run: |
          .venv/bin/pytest tests/ -m "not slow and not external" --durations=30 --cov=app --cov-report=term-missing -q
        timeout-minutes: 60

      - name: Report coverage
        run: |
          .venv/bin/pytest tests/ --cov=app --cov-report=json
          python -c "
import json
with open('coverage.json') as f:
    data = json.load(f)
total = data['totals']['percent_covered']
print(f'Total coverage: {total}%')
assert total >= 80, f'Coverage {total}% < 80% threshold'
"
