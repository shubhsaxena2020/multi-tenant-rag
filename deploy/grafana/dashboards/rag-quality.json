{
  "dashboard": {
    "id": null,
    "uid": "rag-quality",
    "title": "RAG Service — Retrieval Quality",
    "tags": ["rag", "quality", "retrieval"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "1m",
    "time": { "from": "now-24h", "to": "now" },
    "panels": [
      {
        "id": 1, "title": "Faithfulness (avg, 1h)", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
        "targets": [
          { "expr": "avg(rate(rag_faithfulness_sum[1h])) / avg(rate(rag_faithfulness_count[1h]))", "legendFormat": "faithfulness_avg", "type": 0 }
        ],
        "fieldConfig": { "defaults": { "unit": "", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 2 } } }
      },
      {
        "id": 2, "title": "No-answer rate", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
        "targets": [
          { "expr": "sum(rate(rag_no_answer_total[1h])) / sum(rate(rag_query_hits_count[1h]))", "legendFormat": "no_answer_rate", "type": 0 }
        ],
        "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineWidth": 2 } } }
      },
      {
        "id": 3, "title": "Chunks returned / query (avg)", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
        "targets": [
          { "expr": "avg(rate(rag_query_hits_sum[10m])) / avg(rate(rag_query_hits_count[10m]))", "legendFormat": "hits_avg", "type": 0 }
        ],
        "fieldConfig": { "defaults": { "unit": "", "custom": { "drawStyle": "line", "lineWidth": 2 } } }
      },
      {
        "id": 4, "title": "Rewrite usage rate", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
        "targets": [
          { "expr": "sum(rate(rag_query_rewrite_total{used=\"true\"}[1h])) / (sum(rate(rag_query_rewrite_total{used=\"true\"}[1h])) + sum(rate(rag_query_rewrite_total{used=\"false\"}[1h])))", "legendFormat": "rewrite_rate", "type": 0 }
        ],
        "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineWidth": 2 } } }
      },
      {
        "id": 5, "title": "Retrieval latency p95", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
        "targets": [
          { "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[10m])) by (le))", "legendFormat": "p95", "type": 0 }
        ],
        "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2 } } }
      },
      {
        "id": 6, "title": "Quality events ingested (rate)", "type": "timeseries", "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
        "targets": [
          { "expr": "sum(rate(rag_query_hits_count[10m]))", "legendFormat": "queries/s", "type": 0 }
        ]
      }
    ]
  },
  "overwrite": true
}
