# ---- Core ----
QDRANT_URL=http://localhost:6333
DB_URL=sqlite:///./rag_tenants.db
COLLECTION_PREFIX=rag
VECTOR_SIZE=1024

# ---- Auth ----
# If set, POST/GET/DELETE /tenants require an `Admin-Key` header.
# Leave empty only for local/dev (admin endpoints are then open).
ADMIN_API_KEY=

# ---- Embedding (BGE-M3) ----
USE_REAL_EMBEDDER=0
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# ---- Reranking (BGE-Reranker-v2-m3) ----
USE_REAL_RERANKER=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# ---- Optional answer generation (OpenAI-compatible) ----
# When all three are set, POST /{tenant}/query with generate=true calls this provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
