# ---- Core ----
QDRANT_URL=http://localhost:6333
DB_URL=sqlite:///./rag_tenants.db
COLLECTION_PREFIX=rag
VECTOR_SIZE=1024

# ---- Auth ----
# If set, POST/GET/DELETE /tenants require an `Admin-Key` header.
# Leave empty only for local/dev (admin endpoints are then open).
ADMIN_API_KEY=

# ---- Embedding (BGE-M3) ----
USE_REAL_EMBEDDER=0
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# ---- Reranking (BGE-Reranker-v2-m3) ----
USE_REAL_RERANKER=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# ---- Rate limiting (requests/min; 0 disables that dimension) ----
RATE_PER_TENANT_PER_MIN=600
RATE_PER_IP_PER_MIN=120
RATE_INGEST_JOBS_PER_MIN=60

# ---- Observability ----
# GET /metrics exposes Prometheus metrics. Logs are structured JSON to stdout.
