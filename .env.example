# ---- Core ----
QDRANT_URL=http://localhost:6333
DB_URL=sqlite:///./rag_tenants.db
COLLECTION_PREFIX=rag
VECTOR_SIZE=1024

# ---- Auth ----
# If set, POST/GET/DELETE /tenants require an `Admin-Key` header.
# Leave empty only for local/dev (admin endpoints are then open).
ADMIN_API_KEY=

# ---- Encryption-at-rest (per-tenant AES-GCM envelope, KMS-style) ----
# 32 raw bytes (base64 or 64-hex). REQUIRED in production — without it, chunk text is
# stored in plaintext. Generate: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# ---- Embedding (BGE-M3) ----
USE_REAL_EMBEDDER=0
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
# Optional: point at a Text Embeddings Inference (TEI) GPU node to offload embedding.
# When set, embedding is done over HTTP instead of in-process.
EMBED_BASE_URL=
EMBED_API_KEY=

# ---- Reranking (BGE-Reranker-v2-m3) ----
USE_REAL_RERANKER=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# ---- Tenant quotas (fleet protection; 0 disables) ----
TENANT_CHUNK_QUOTA=5000000

# ---- Rate limiting (requests/min; 0 disables that dimension) ----
RATE_PER_TENANT_PER_MIN=600
RATE_PER_IP_PER_MIN=120
RATE_INGEST_JOBS_PER_MIN=60

# ---- Optional answer generation (OpenAI-compatible) ----
# When all three are set, POST /{tenant}/query with generate=true calls this provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Observability ----
# GET /metrics exposes Prometheus metrics. Logs are structured JSON to stdout.
