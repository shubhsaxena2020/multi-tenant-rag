#!/home/ubuntu/rag-service/.venv/bin/python
"""Tiny pure-Python git CLI using dulwich (no `git` binary on this host).

Supports the subset needed for this project's commit+tag milestone workflow:
  .gitpy status
  .gitpy add <paths...> | --all
  .gitpy commit "msg"
  .gitpy tag <name> [--force]
  .gitpy log [-n N]
  .gitpy head
"""
from __future__ import annotations

import os
import sys
import time

from dulwich.repo import Repo
from dulwich import porcelain

REPO = os.path.dirname(os.path.abspath(__file__))


def _identity(repo: Repo) -> bytes:
    """Resolve committer/author 'Name <email>' from .git/config or sane defaults."""
    name = email = None
    try:
        cfg = repo.get_config()
        name = cfg.get((b"user",), b"name")
        email = cfg.get((b"user",), b"email")
    except Exception:
        pass
    name = (name.decode() if isinstance(name, bytes) else name) or "Hermes Agent"
    email = (email.decode() if isinstance(email, bytes) else email) or "hermes@nousresearch.com"
    return f"{name} <{email}>".encode()


def cmd_status():
    st = porcelain.status(REPO)
    print("staged (added):", list(st[0]) or "{}")
    print("unstaged:", list(st[1]) or "{}")
    print("untracked:", list(st[2]) or "{}")


def cmd_add(paths):
    if paths == ["--all"] or paths == ["."]:
        porcelain.add(REPO)
    else:
        for p in paths:
            porcelain.add(REPO, p)


def cmd_commit(msg):
    repo = Repo(REPO)
    ident = _identity(repo)
    now = int(time.time())
    off = 0
    commit_id = porcelain.commit(
        REPO,
        message=msg.encode(),
        author=ident,
        committer=ident,
        author_timestamp=now,
        commit_timestamp=now,
        author_timezone=off,
        commit_timezone=off,
    )
    print("committed", commit_id.decode()[:12])


def cmd_tag(name, force=False):
    repo = Repo(REPO)
    ref_name = b"refs/tags/" + name.encode()
    if force and ref_name in repo.refs:
        del repo.refs[ref_name]
        peeled = ref_name + b"^{}"
        if peeled in repo.refs:
            del repo.refs[peeled]
    porcelain.tag_create(
        REPO, name.encode(), message=f"tag {name}".encode(), annotated=True
    )
    print("tagged", name)


def cmd_log(n=10):
    repo = Repo(REPO)
    entries = list(porcelain.log(repo))
    for i, entry in enumerate(entries):
        if i >= n:
            break
        print(entry.decode()[:12])


def cmd_head():
    repo = Repo(REPO)
    print("HEAD:", repo.head().decode())


if __name__ == "__main__":
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        sys.exit(1)
    cmd = args[0]
    rest = args[1:]
    if cmd == "status":
        cmd_status()
    elif cmd == "add":
        cmd_add(rest)
    elif cmd == "commit":
        cmd_commit(" ".join(rest))
    elif cmd == "tag":
        force = "--force" in rest
        rest = [a for a in rest if a != "--force"]
        cmd_tag(rest[0], force=force)
    elif cmd == "log":
        n = 10
        if rest and rest[0] == "-n":
            n = int(rest[1])
        cmd_log(n)
    elif cmd == "head":
        cmd_head()
    else:
        print("unknown", cmd)
        sys.exit(1)
